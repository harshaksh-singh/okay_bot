# ==============================================================================
# AI Job Application Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in secrets. NEVER commit .env to version control.

# ---- Core ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Mode flags (DEFAULT SAFE) ----
MOCK_MODE=true
DRY_RUN=true
USER_APPROVAL_REQUIRED=true
AUTO_SUBMIT=false
AUTO_EMAIL=false
AUTO_MESSAGE=false
CAPTCHA_BYPASS=false
MFA_BYPASS=false
RATE_LIMIT_BYPASS=false

# ---- Phase 3: Pre-approved execution (DEFAULT SAFE / OFF) ----
# Enabling these allows the pipeline to execute pre-approved applications
# without per-item approval, but hard-stops still fire on CAPTCHA/MFA/OTP/
# identity-verification/payment/unknown-sensitive-question.
PRE_APPROVED_APPLICATIONS=false
AUTO_SUBMIT_APPROVED=false
AUTO_EMAIL_APPROVED=false
AUTO_MESSAGE_APPROVED=false
COMPLIANCE_HARD_BLOCK=true
TRUTHFULNESS_HARD_BLOCK=true

# ---- Phase 3: Application tiering ----
AUTO_APPLY_MATCH_THRESHOLD=85
AUTO_APPLY_QUALITY_THRESHOLD=80
REVIEW_REQUIRED_MATCH_FLOOR=75

# ---- Phase 3: Harban AI Labs client acquisition ----
HARBAN_WEBSITE=https://harban-ai-labs.vercel.app/
HARBAN_ENABLED=true
HARBAN_CLIENT_SCORE_THRESHOLD=70

# ---- Phase 3: Outreach limits ----
OUTREACH_MAX_PROSPECTS_PER_DAY=10
OUTREACH_MAX_LINKEDIN_PER_DAY=5
OUTREACH_MAX_EMAILS_PER_DAY=10
OUTREACH_MAX_INITIAL_PER_CONTACT=1
OUTREACH_MAX_FOLLOWUPS_PER_CONTACT=1
OUTREACH_FOLLOWUP_DAY_1=5
OUTREACH_FOLLOWUP_DAY_2=12

# ---- Database ----
# For local development, SQLite is used by default. Set DATABASE_URL to a
# PostgreSQL connection string for production.
DATABASE_URL=sqlite:///./data/job_agent.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/job_agent

# ---- Redis (optional) ----
# REDIS_URL=redis://localhost:6379/0

# ---- LLM Provider (choose one or more) ----
# All disabled by default -> MockLLMProvider is used
LLM_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Discovery Sources (ALL DISABLED BY DEFAULT) ----
LINKEDIN_ENABLED=false
INDEED_ENABLED=false
NAUKRI_ENABLED=false
GLASSDOOR_ENABLED=false
WELLFOUND_ENABLED=false
HANDSHAKE_ENABLED=false
INSTAHYRE_ENABLED=false
HIRIST_ENABLED=false
FOUNDIT_ENABLED=false
INTERNSHALA_ENABLED=false
REMOTEOK_ENABLED=false
WEWORKREMOTELY_ENABLED=false
CUTSHORT_ENABLED=false
GOOGLE_SEARCH_ENABLED=false
HACKERNEWS_ENABLED=false
COMPANY_CAREERS_ENABLED=false
OUTLIER_ENABLED=false
SURGE_AI_ENABLED=false
TELUS_DIGITAL_AI_ENABLED=false

# ==============================================================================
# PHASE 5: ACCOUNT IDENTIFIERS (NO PASSWORDS, EVER)
# ==============================================================================
# These are USERNAMES / EMAIL ADDRESSES / PROFILE URLs only — NOT passwords.
# Passwords are typed by YOU into the real platform's login page the ONE time
# you run `make login-<platform>`; the Playwright persistent profile at
# ./browser/profiles/<platform>/ holds the resulting session cookies.
#
# NEVER add any *_PASSWORD / *_SECRET / *_TOKEN key here. The AccountConfig
# validator rejects password-shaped identifiers. OAuth refresh tokens live in
# macOS Keychain via `keyring`, never in this file.
# ==============================================================================

# LinkedIn
# LINKEDIN_EMAIL=
# LINKEDIN_PROFILE_URL=

# Naukri
# NAUKRI_EMAIL=
# NAUKRI_PROFILE_URL=

# Indeed
# INDEED_EMAIL=
# INDEED_PROFILE_URL=

# Glassdoor
# GLASSDOOR_EMAIL=

# Wellfound
# WELLFOUND_EMAIL=

# Handshake
# HANDSHAKE_EMAIL=

# Cutshort / Instahyre / Hirist / Foundit / Internshala
# CUTSHORT_EMAIL=
# INSTAHYRE_EMAIL=
# HIRIST_EMAIL=
# FOUNDIT_EMAIL=
# INTERNSHALA_EMAIL=

# Remote boards (public; no account required but you can set for display)
# REMOTEOK_EMAIL=
# WEWORKREMOTELY_EMAIL=

# AI contractor platforms
# OUTLIER_EMAIL=
# SURGE_AI_EMAIL=
# TELUS_DIGITAL_AI_EMAIL=

# Gmail (OAuth; identifier only — refresh token lives in macOS Keychain)
# GMAIL_ACCOUNT=
# M365_ACCOUNT=

# Harban AI Labs (business email)
# HARBAN_BUSINESS_EMAIL=

# ---- Browser Automation (DISABLED BY DEFAULT) ----
BROWSER_AUTOMATION_ENABLED=false
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_USER_DATA_DIR=./browser

# ---- Email (DISABLED BY DEFAULT) ----
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
# EMAIL_OAUTH_CLIENT_ID=
# EMAIL_OAUTH_CLIENT_SECRET=
# EMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback
# EMAIL_SENDER_ADDRESS=
EMAIL_DRAFT_ONLY=true

# ---- Scheduling ----
SCHEDULER_ENABLED=false
SCHEDULE_MORNING_IST=09:00
SCHEDULE_EVENING_IST=18:00
SCHEDULE_NIGHT_IST=22:00

# ---- Scoring Thresholds (0-100) ----
SCORE_APPLY_IMMEDIATELY=95
SCORE_HIGH_PRIORITY=85
SCORE_APPLY=75
SCORE_CONSIDER=65
SCORE_LOW_PRIORITY=50

# ---- Matching Weights (sum to 1.0) ----
WEIGHT_TECHNICAL_SKILLS=0.30
WEIGHT_EXPERIENCE=0.20
WEIGHT_ROLE_RELEVANCE=0.15
WEIGHT_LOCATION=0.10
WEIGHT_EMPLOYMENT_TYPE=0.10
WEIGHT_SCHEDULE=0.05
WEIGHT_COMPANY_PRIORITY=0.05
WEIGHT_SALARY=0.05
